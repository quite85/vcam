<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>日常切换请按「音量减」调出悬浮窗</string>
			<key>footerText</key>
			<string>下面这些是"慢慢调"的参数。图片/视频/OBS/禁用 的快速切换在音量减悬浮窗里。</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>OBS / 电脑推流</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSEditTextCell</string>
			<key>label</key>
			<string>监听端口</string>
			<key>key</key>
			<string>port</string>
			<key>default</key>
			<integer>5600</integer>
			<key>keyboardType</key>
			<integer>4</integer>
			<key>placeholder</key>
			<string>5600</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSListItemsController</string>
			<key>label</key>
			<string>传输协议</string>
			<key>key</key>
			<string>transport</string>
			<key>default</key>
			<string>udp</string>
			<key>validValues</key>
			<array>
				<string>udp</string>
				<string>tcp</string>
			</array>
			<key>titles</key>
			<array>
				<string>UDP（低延迟，推荐）</string>
				<string>TCP（更稳，延迟略高）</string>
			</array>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSEditTextCell</string>
			<key>label</key>
			<string>抖动缓冲 (ms)</string>
			<key>key</key>
			<string>latencyMs</string>
			<key>default</key>
			<integer>120</integer>
			<key>keyboardType</key>
			<integer>4</integer>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>画面</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSListItemsController</string>
			<key>label</key>
			<string>旋转</string>
			<key>key</key>
			<string>rotation</string>
			<key>default</key>
			<integer>0</integer>
			<key>validValues</key>
			<array>
				<integer>0</integer>
				<integer>90</integer>
				<integer>180</integer>
				<integer>270</integer>
			</array>
			<key>titles</key>
			<array>
				<string>0°</string>
				<string>90°</string>
				<string>180°</string>
				<string>270°</string>
			</array>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>左右镜像</string>
			<key>key</key>
			<string>mirror</string>
			<key>default</key>
			<false/>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>视频循环播放</string>
			<key>key</key>
			<string>loop</string>
			<key>default</key>
			<true/>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>音频</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSEditTextCell</string>
			<key>label</key>
			<string>音量增益 (0.0-2.0)</string>
			<key>key</key>
			<string>audioVolume</string>
			<key>default</key>
			<real>1.0</real>
			<keyboardType</key>
			<integer>8</integer>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSEditTextCell</string>
			<key>label</key>
			<string>唇形同步偏移 (ms，正数=音频延后)</string>
			<key>key</key>
			<string>lipSyncMs</string>
			<key>default</key>
			<integer>0</integer>
			<key>keyboardType</key>
			<integer>4</integer>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>稳定性 / 排查</string>
			<key>footerText</key>
			<string>如果装了 VCam 后相机完全不可用，把"仅 App 层注入"打开（跳过 mediaserverd 层），然后重启一次设备或运行 killall mediaserverd。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>仅 App 层注入（跳过 mediaserverd）</string>
			<key>key</key>
			<string>appLayerOnly</string>
			<key>default</key>
			<false/>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>mediaserverd 层已降级</string>
			<key>key</key>
			<string>msdDisabled</string>
			<key>default</key>
			<false/>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>工具</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>查看日志</string>
			<key>action</key>
			<string>openLog</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>清空日志</string>
			<key>action</key>
			<string>clearLog</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>重置所有设置</string>
			<key>action</key>
			<string>resetAll</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>使用须知与免责声明</string>
			<key>action</key>
			<string>showDisclaimer</string>
		</dict>
	</array>
	<key>title</key>
	<string>VCam</string>
</dict>
</plist>
