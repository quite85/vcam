<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  VCam 主 tweak 的 entitlements。

  说明：
   - 越狱环境下 dynamic library 的签名通常被 ldid/ElleKit 重新签名，
     entitlements 主要是为了让 ldid 给二进制打上"可被注入 mediaserverd"的标记。
   - 如果使用 ElleKit + Dopamine，一般不需要 entitlements，直接从过滤器加载即可。
   - task_for_pid-allow / platform-application 只在少数需要 attach 的场景需要，
     不申请也能正常注入（越狱 daemon 自身已有 root）。
   - 请不要把本文件用于 App Store 提交，会直接被拒。
-->
<plist version="1.0">
<dict>
	<key>platform-application</key>
	<true/>
	<key>com.apple.private.security.no-container</key>
	<true/>
	<key>com.apple.private.security.container-required</key>
	<false/>
	<key>com.apple.private.skip-library-validation</key>
	<true/>
	<key>com.apple.private.security.storage.MobileAsset</key>
	<true/>
	<!-- 读取相册（用户在插件内选择视频/图片） -->
	<key>com.apple.private.photos.allowread</key>
	<true/>
	<key>com.apple.private.tcc.allow</key>
	<array>
		<string>kTCCServiceCamera</string>
		<string>kTCCServiceMicrophone</string>
		<string>kTCCServicePhotos</string>
	</array>
	<!-- 局域网监听（OBS 推流） -->
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
